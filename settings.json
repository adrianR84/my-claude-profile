{
  "respectGitignore": true,
  "cleanupPeriodDays": 99999,
  "env": {
    "API_TIMEOUT_MS": "3000000",
    "CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC": "1",
    "CLAUDE_CODE_DISABLE_1M_CONTEXT": "0",
    "CLAUDE_CODE_DISABLE_AUTO_MEMORY": "0",
    "CLAUDE_CODE_NO_FLICKER": "1",
    "CLAUDE_CODE_DISABLE_ADAPTIVE_THINKING": "1",
    "MAX_THINKING_TOKENS": "21999",
    "CLAUDE_CODE_EFFORT_LEVEL": "max",
    "CLAUDE_CODE_SUBAGENT_MODEL": "sonnet",
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1",
    "ENABLE_TOOL_SEARCH": "true",
    "DISABLE_AUTOUPDATER": "1",
    "CLAUDE_CODE_FORK_SUBAGENT": "0",
    "CLAUDE_AUTOCOMPACT_PCT_OVERRIDE": "65"
  },
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "permissions": {
    "allow": [],
    "deny": [
      "Read(**/.dev.vars*)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Read(**/secrets/**)",
      "Read(**/credentials/**)",
      "Read(**/.aws/**)",
      "Read(**/.ssh/**)",
      "Read(**/config/database.yml)",
      "Read(**/config/credentials.json)",
      "Read(**/.npmrc)",
      "Read(**/.pypirc)",
      "Write(**/secrets/**)",
      "Write(**/.ssh/**)",
      "Write(.github/workflows/*)",
      "Bash(sudo *)",
      "Bash(npm publish *)",
      "Bash(curl * | sh)"
    ],
    "ask": [
	  "Read(**/.env*)",
	  "Write(**/.env*)",
	  
      "Bash(git -C push *)",
      "Bash(git push *)",
      "Bash(rm *)",
      "Bash(rm -rf *)",
      "Bash(wget *)",
      "Bash(chmod *)"
    ],
    "defaultMode": "auto"
  },
  "model": "opus[1m]",
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"C:/Users/adria/.claude/hooks/mmx-quota-block.js\""
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "npx -y ccstatusline@latest",
    "padding": 0,
    "refreshInterval": 60
  },
  "enabledPlugins": {
    "superpowers@claude-plugins-official": false,
    "frontend-design@claude-plugins-official": false,
    "feature-dev@claude-plugins-official": true,
    "code-simplifier@claude-plugins-official": true,
    "ralph-loop@claude-plugins-official": false,
    "chrome-devtools-mcp@claude-plugins-official": false,
    "code-review@claude-plugins-official": false,
    "hookify@claude-plugins-official": false,
    "security-guidance@claude-plugins-official": false,
    "playground@claude-plugins-official": false,
    "claude-code-setup@claude-plugins-official": true,
    "plugin-dev@claude-plugins-official": true,
    "skill-creator@claude-plugins-official": true,
    "toast-notifications@claude-code-awesome": true,
    "protective-hooks@claude-code-awesome": true,
    "rss-aggregator@claude-code-awesome": true,
    "minimal-claude@claude-code-awesome": false,
    "micro-skill-pipeline@claude-code-awesome": false,
    "llm-wiki-compiler@claude-code-awesome": false,
    "tdd-guard@claude-code-awesome": false,
    "obsidian@claude-code-awesome": true,
    "all-permissions@claude-code-awesome": true,
    "last30days@claude-code-awesome": false,
    "claude-code-clock@claude-code-awesome": true,
    "context7@claude-plugins-official": true,
    "pixelbrowse@claude-code-awesome": true,
    "ponytail@claude-code-awesome": true
  },
  "effortLevel": "low",
  "autoUpdatesChannel": "latest",
  "autoMemoryEnabled": true,
  "skipDangerousModePermissionPrompt": true,
  "autoCompactEnabled": true
}
